package com.winols.app.data

import com.winols.app.model.DataType
import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.withContext
import java.io.File
import java.io.RandomAccessFile
import java.nio.ByteBuffer
import java.nio.ByteOrder

class BinaryBufferManager {

    private var buffer: ByteBuffer? = null
    var fileSize: Int = 0
        private set

    suspend fun loadFile(file: File): Boolean = withContext(Dispatchers.IO) {
        try {
            RandomAccessFile(file, "r").use { raf ->
                fileSize = raf.length().toInt()
                val direct = ByteBuffer.allocateDirect(fileSize)
                raf.channel.read(direct)
                direct.flip()
                buffer = direct
            }
            true
        } catch (e: Exception) {
            e.printStackTrace()
            false
        }
    }

    suspend fun saveToFile(file: File): Boolean = withContext(Dispatchers.IO) {
        val buf = buffer ?: return@withContext false
        try {
            RandomAccessFile(file, "rw").use { raf ->
                buf.rewind()
                raf.channel.write(buf)
                buf.rewind()
            }
            true
        } catch (e: Exception) {
            e.printStackTrace()
            false
        }
    }

    @Synchronized
    fun readRawValue(address: Long, type: DataType): Double {
        val buf = buffer ?: return 0.0
        val offset = address.toInt()
        if (offset < 0 || offset + type.byteSize > fileSize) return 0.0

        buf.order(type.byteOrder)
        return when (type) {
            DataType.UBYTE -> (buf.get(offset).toInt() and 0xFF).toDouble()
            DataType.SBYTE -> buf.get(offset).toDouble()
            DataType.UWORD_LE, DataType.UWORD_BE -> (buf.getShort(offset).toInt() and 0xFFFF).toDouble()
            DataType.SWORD_LE, DataType.SWORD_BE -> buf.getShort(offset).toDouble()
        }
    }

    @Synchronized
    fun writeRawValue(address: Long, type: DataType, rawValue: Double) {
        val buf = buffer ?: return
        val offset = address.toInt()
        if (offset < 0 || offset + type.byteSize > fileSize) return

        buf.order(type.byteOrder)
        when (type) {
            DataType.UBYTE, DataType.SBYTE -> buf.put(offset, rawValue.toInt().toByte())
            DataType.UWORD_LE, DataType.UWORD_BE,
            DataType.SWORD_LE, DataType.SWORD_BE -> buf.putShort(offset, rawValue.toInt().toShort())
        }
    }

    @Synchronized
    fun getDirectBuffer(): ByteBuffer? = buffer?.asReadOnlyBuffer()
}
