<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212">

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:background="#1E1E1E">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnLoadBin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Otwórz BIN"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnSelectMap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wybierz Mapę"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnModifyCell"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Edytuj Komórkę" />
        </LinearLayout>
    </HorizontalScrollView>

    <com.winols.app.ui.EcuGridView
        android:id="@+id/ecuGridView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>