<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:background="#121212" android:layout_height="match_parent" android:layout_width="match_parent" android:orientation="vertical" android:padding="8dp" xmlns:android="[http://schemas.android.com/apk/res/android](http://schemas.android.com/apk/res/android)">

    <TextView android:id="@+id/mapTitle" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:layout_width="wrap_content" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"/>

    <TextView android:layout_height="wrap_content" android:layout_width="wrap_content" android:text="2D Curves View" android:textColor="#888888" android:textSize="12sp"/>

    <com.winols.app.ui.views.Map2DView
        android:id="@+id/map2DView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#1E1E1E" />

    <TextView android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_width="wrap_content" android:text="Dynamic 3D Mesh (Drag to rotate, pinch to zoom)" android:textColor="#888888" android:textSize="12sp"/>

    <com.winols.app.ui.views.Map3DView
        android:id="@+id/map3DView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.3"
        android:background="#1E1E1E" />
</LinearLayout>