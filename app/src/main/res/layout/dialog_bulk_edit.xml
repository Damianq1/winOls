<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#242424">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Masowa edycja zaznaczenia"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <RadioGroup
        android:id="@+id/rgOperation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RadioButton
            android:id="@+id/rbOffset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dodaj / Odejmij wartość (+/-)"
            android:textColor="#EEEEEE"
            android:checked="true" />

        <RadioButton
            android:id="@+id/rbPercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Zmiana procentowa (%)"
            android:textColor="#EEEEEE" />

        <RadioButton
            android:id="@+id/rbSetValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Wklej stałą wartość"
            android:textColor="#EEEEEE" />

        <RadioButton
            android:id="@+id/rbSmooth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Wygładzanie (Średnia sąsiedztwa)"
            android:textColor="#EEEEEE" />
    </RadioGroup>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/inputLayoutValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColorHint="#9E9E9E">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Wartość (np. 50, -20, 5%)"
            android:inputType="numberSigned|numberDecimal"
            android:textColor="#FFFFFF" />
    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>